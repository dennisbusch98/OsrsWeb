# Production env template - used on Render (or any other host). Copy this
# to .env there (or, more commonly, just set the same keys as environment
# variables in Render's dashboard - Render will inject them automatically,
# you don't even need an actual .env file on the server).

PORT=4000
NODE_ENV=production

# --- MySQL ---
# On Render: point these at your MySQL instance's connection details
# (host/port/user/password/database name as shown in its dashboard).
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=osrs
DB_USER=Osrs
DB_PASSWORD=change-this-in-render-dashboard
# Most managed MySQL providers require SSL for external connections:
DB_SSL=true

# --- Auth ---
JWT_SECRET=change-this-to-something-long-and-random
JWT_EXPIRES_IN=7d

# --- Loot webhook (see README for RuneLite setup) ---
WEBHOOK_SECRET=change-this-too
